<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><meta name="theme-color" content="#090909">
<title>Fight Predictor</title>
<style>
:root{color-scheme:dark;--bg:#090909;--surface:#0e0e0e;--line:#2b2b2b;--soft:#1d1d1d;--text:#f1f1ef;--sub:#b3b3b0;--muted:#777774;--red:#d8232a;--danger:#ff6b70;--font:Arial,Helvetica,system-ui,sans-serif;font-family:var(--font)}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px;min-height:100vh;background:var(--bg);color:var(--text);font-family:var(--font);font-size:15px;line-height:1.5;font-variant-numeric:tabular-nums}button,input{font:inherit}.shell{width:min(1080px,calc(100% - 40px));margin:auto}a{color:inherit}
.site-header{border-bottom:1px solid var(--line)}.navbar{height:56px;display:flex;align-items:stretch;justify-content:space-between}.brand{display:flex;align-items:center;gap:10px;font-size:15px;font-weight:700;text-decoration:none}.brand:before{content:"";width:3px;height:22px;background:var(--red)}.nav{display:flex}.nav a{display:grid;place-items:center;min-width:76px;padding:0 10px;border-bottom:2px solid transparent;color:var(--sub);font-size:12px;font-weight:600;letter-spacing:.03em;text-decoration:none;text-transform:uppercase}.nav a:hover{color:#fff}.nav a.active{color:#fff;border-color:var(--red)}
main{padding:32px 0 56px}.page-head{display:flex;align-items:end;justify-content:space-between;gap:24px;padding-bottom:18px;border-bottom:1px solid var(--line)}.page-head h1{margin:0;font-size:30px;line-height:1.15;font-weight:700;letter-spacing:-.02em}.page-head p{margin:7px 0 0;color:var(--sub);font-size:14px}.meta{color:var(--muted);font-size:12px}.section{margin-top:36px}.section-head{display:flex;align-items:baseline;justify-content:space-between;gap:16px;margin-bottom:12px}.section-head h2{margin:0;font-size:17px;line-height:1.25;font-weight:700}.section-head a{color:var(--sub);font-size:13px}.eyebrow{margin:0 0 6px;color:var(--red);font-size:12px;font-weight:600}.empty-state{padding:28px 0;border-block:1px solid var(--line);color:var(--sub)}.empty-state strong{display:block;margin-bottom:4px;color:var(--text);font-size:16px}.empty-state p{margin:0;max-width:620px}
.event-list{border-top:1px solid var(--line)}.event-link{display:grid;grid-template-columns:130px 1fr auto;gap:24px;align-items:center;padding:18px 0;border-bottom:1px solid var(--line);text-decoration:none}.event-link:hover .event-name{text-decoration:underline;text-decoration-color:var(--red);text-underline-offset:4px}.event-date{color:var(--sub);font-size:13px}.event-name{font-size:17px;font-weight:700}.event-location{margin-top:3px;color:var(--muted);font-size:13px}.event-count{color:var(--muted);font-size:12px}
.record-strip{display:grid;grid-template-columns:repeat(4,1fr);border-block:1px solid var(--line)}.record-stat{min-height:74px;padding:14px 18px;border-left:1px solid var(--soft)}.record-stat:first-child{border-left:0;padding-left:0}.record-label{color:var(--muted);font-size:12px}.record-value{margin-top:5px;font-size:18px;font-weight:600}.record-note{margin:10px 0 0;color:var(--muted);font-size:12px}
.event-header{padding-bottom:24px;border-bottom:1px solid var(--line)}.event-header h1{margin:0;font-size:30px;line-height:1.15}.event-details{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:8px;color:var(--sub);font-size:14px}.source-note{margin-top:10px;color:var(--muted);font-size:12px}.fight-card{border-top:1px solid var(--line)}.fight-row{padding:24px 0;border-bottom:1px solid var(--line)}.fight-row.main-event{padding-top:30px}.bout-label{margin-bottom:14px;color:var(--muted);font-size:12px;font-weight:600}.fight-matchup{display:grid;grid-template-columns:minmax(0,1fr) 80px minmax(0,1fr);align-items:center}.fight-side{min-width:0}.fight-side.right{text-align:right}.fight-name{font-size:24px;line-height:1.12;font-weight:700;overflow-wrap:anywhere}.fight-percent{margin-top:5px;font-size:42px;line-height:1;font-weight:700;letter-spacing:-.03em}.fight-vs{color:var(--muted);font-size:13px;text-align:center}.pick-mark{display:inline-block;margin-bottom:6px;color:var(--red);font-size:11px;font-weight:600}.probability{display:grid;grid-template-columns:var(--left) 1fr;height:6px;margin:18px 0;background:#b8b8b5}.probability span:first-child{background:var(--red)}.fight-summary{display:grid;grid-template-columns:repeat(3,1fr);border-block:1px solid var(--soft)}.summary-cell{padding:11px 14px;border-left:1px solid var(--soft)}.summary-cell:first-child{border-left:0;padding-left:0}.summary-label{color:var(--muted);font-size:12px}.summary-value{margin-top:2px;font-size:14px;font-weight:600}.reason-summary{display:flex;flex-wrap:wrap;gap:8px 20px;margin-top:13px;color:var(--sub);font-size:13px}.reason-summary strong{color:var(--text);font-weight:600}.unavailable{padding:18px 0;color:var(--sub)}.unavailable strong{display:block;color:var(--text)}
.predict-grid{display:grid;grid-template-columns:minmax(0,1fr) 54px minmax(0,1fr);border-top:3px solid var(--red);border-bottom:1px solid var(--line);background:var(--surface)}.fighter-box{min-width:0;padding:24px}.fighter-box.right{text-align:right}.fighter-label{color:var(--muted);font-size:12px}.selected-name{min-height:33px;margin:5px 0 14px;font-size:24px;line-height:1.15;font-weight:700;overflow-wrap:anywhere}.selected-name.empty{color:#555}.versus{display:grid;place-items:center;border-inline:1px solid var(--line);color:var(--muted);font-size:13px}
.fighter-search{position:relative;text-align:left}.search-input{width:100%;height:44px;padding:0 12px;border:1px solid #444;border-radius:2px;outline:0;background:#090909;color:var(--text)}.search-input:focus{border-color:#aaa;box-shadow:inset 3px 0 var(--red)}.search-input[aria-invalid=true]{border-color:var(--danger)}.options{display:none;position:absolute;z-index:20;top:47px;inset-inline:0;max-height:286px;overflow:auto;border:1px solid #484848;background:#101010;box-shadow:0 12px 24px #000a}.options.open{display:block}.list-status{position:sticky;top:0;z-index:1;padding:6px 11px;border-bottom:1px solid var(--soft);background:#101010;color:var(--muted);font-size:12px}.option{display:block;width:100%;min-height:35px;padding:7px 11px;border:0;border-bottom:1px solid var(--soft);border-radius:0;background:transparent;color:#ddd;text-align:left;font-size:14px;cursor:pointer;content-visibility:auto}.option:hover,.option.active{background:#242424}.option[aria-selected=true]{box-shadow:inset 3px 0 var(--red)}.option mark{padding:0;background:transparent;color:#fff;font-weight:700}.no-options{padding:14px 11px;color:var(--muted)}
.form-actions{display:grid;grid-template-columns:1fr 280px;align-items:center;gap:20px;padding-top:14px}.error{min-height:20px;margin:0;color:var(--danger);font-size:13px}.button{height:44px;border:1px solid var(--red);border-radius:2px;background:var(--red);color:#fff;font-size:13px;font-weight:700;letter-spacing:.025em;text-transform:uppercase;cursor:pointer}.button:hover:not(:disabled){background:#ef2a31}.button:focus-visible{outline:2px solid #fff;outline-offset:2px}.button:disabled{border-color:#383838;background:#282828;color:#777;cursor:not-allowed}
.prediction-result{display:none;margin-top:30px}.prediction-result.visible{display:block}.result-head{display:flex;justify-content:space-between;gap:16px;padding-bottom:10px;border-bottom:1px solid var(--line)}.manual-fight{padding:24px 0}.details-grid{display:grid;grid-template-columns:.9fr 1.1fr;border-block:1px solid var(--line)}.detail-stats{display:grid;grid-template-columns:1fr 1fr}.detail{min-height:78px;padding:13px 16px;border-right:1px solid var(--soft);border-bottom:1px solid var(--soft)}.detail-label{color:var(--muted);font-size:12px}.detail-value{margin-top:4px;font-size:16px;font-weight:600}.method-panel{padding:16px}.method-panel h3,.reason-panel h3{margin:0 0 12px;font-size:16px}.method-list{display:grid;gap:10px}.method-row{display:grid;grid-template-columns:82px 1fr 45px;align-items:center;gap:10px;color:var(--sub);font-size:13px}.method-track{height:5px;background:#303030}.method-fill{height:100%;background:var(--red)}.method-value{text-align:right;color:var(--text)}.method-note{margin:12px 0 0;color:var(--muted);font-size:12px}.reasons{display:grid;grid-template-columns:1.2fr .8fr;border-bottom:1px solid var(--line)}.reason-panel{padding:20px 16px}.reason-panel+.reason-panel{border-left:1px solid var(--line)}.reason-list{display:grid;gap:14px;margin:0;padding:0;list-style:none}.reason-category{font-size:14px;font-weight:600}.reason-level{margin-left:6px;color:var(--red);font-size:12px;font-weight:400}.reason-copy{margin-top:3px;color:var(--sub);font-size:13px;line-height:1.45}.counter .reason-level{color:var(--muted)}
.matchup-warning{margin:12px 0 0;padding:10px;border-left:3px solid var(--danger);background:#211012;color:#ffd5d7;font-size:12px}.outcome-title{margin-top:18px!important}
.history-table{width:100%;border-collapse:collapse}.history-table th,.history-table td{padding:11px 10px;border-bottom:1px solid var(--line);text-align:left;font-size:13px}.history-table th{color:var(--muted);font-size:12px;font-weight:400}.history-table td:first-child,.history-table th:first-child{padding-left:0}
.loading{padding:24px 0;color:var(--muted)}
@media(max-width:760px){.shell{width:calc(100% - 28px)}.navbar{height:auto;flex-direction:column}.brand{height:48px;border-bottom:1px solid var(--soft)}.nav{height:40px}.nav a{flex:1;min-width:0;padding:0 5px;font-size:11px}.page-head{display:block}.page-head .meta{display:block;margin-top:10px}.record-strip{grid-template-columns:1fr 1fr}.record-stat:nth-child(odd){border-left:0}.record-stat:first-child{padding-left:18px}.event-link{grid-template-columns:1fr;gap:4px}.event-count{display:none}.predict-grid{grid-template-columns:1fr}.fighter-box{padding:18px}.fighter-box.right{text-align:left}.versus{min-height:40px;border-inline:0;border-block:1px solid var(--line)}.form-actions{grid-template-columns:1fr}.button{grid-row:1}.fight-matchup{grid-template-columns:minmax(0,1fr) 34px minmax(0,1fr)}.fight-name{font-size:21px}.fight-percent{font-size:36px}.fight-summary{grid-template-columns:1fr}.summary-cell{border-left:0;border-top:1px solid var(--soft);padding-left:0}.details-grid,.reasons{grid-template-columns:1fr}.method-panel,.reason-panel+.reason-panel{border-left:0;border-top:1px solid var(--line)}.history-wrap{overflow-x:auto}.history-table{min-width:650px}}
@media(max-width:420px){main{padding-top:24px}.page-head h1,.event-header h1{font-size:26px}.selected-name{font-size:21px}.detail-stats{grid-template-columns:1fr}.detail{border-right:0}.fight-name{font-size:19px}.fight-percent{font-size:34px}.record-strip{grid-template-columns:1fr}.record-stat,.record-stat:nth-child(odd){border-left:0;padding-left:0}}

/* Fighter portraits */
.fight-row .fight-matchup{align-items:stretch;background:linear-gradient(90deg,#251015 0%,#111 45%,#111 55%,#141c27 100%);overflow:hidden}
.fight-row .fight-side{display:flex;align-items:center;gap:12px;min-height:280px;padding:12px 16px 0 0;position:relative}
.fight-row .fight-side.right{flex-direction:row-reverse;padding:12px 0 0 16px}
.fighter-portrait{position:relative;align-self:stretch;flex:0 0 48%;margin:0;min-width:0;display:flex;align-items:flex-end;justify-content:center;overflow:hidden}
.fighter-portrait img{position:relative;z-index:1;display:block;width:100%;height:280px;object-fit:contain;object-position:center bottom;filter:drop-shadow(0 8px 18px #0008)}
.fighter-portrait svg{position:absolute;width:90%;height:82%;bottom:0;fill:#303034}
.portrait-fallback{display:none;position:absolute;bottom:14px;color:#9a9a9a;font-size:10px;text-align:center}
.fighter-portrait.no-photo .portrait-fallback{display:block}.fighter-portrait.no-photo img{display:none}.fighter-portrait.loaded svg{display:none}
.fighter-copy{position:relative;z-index:2;flex:1;min-width:0;padding:20px 0;text-shadow:0 2px 12px #000}
.fight-row .fight-name{font-size:clamp(20px,2.4vw,30px);text-transform:uppercase;letter-spacing:-.025em}
.fight-row .fight-vs{display:grid;place-items:center;font-size:15px;font-style:italic;font-weight:700}
.fight-row.main-event .fighter-portrait img{height:330px}.fight-row.main-event .fight-side{min-height:330px}
.event-link.with-portraits{position:relative;grid-template-columns:130px 1fr 220px;min-height:160px;overflow:hidden;padding-right:0}
.event-link.with-portraits .event-name,.event-link.with-portraits .event-date,.event-link.with-portraits .event-location{position:relative;z-index:2}
.event-portraits{display:flex;align-self:stretch;min-width:0;background:radial-gradient(ellipse at bottom,#292126,transparent 75%)}
.event-portraits .fighter-portrait{flex:1}.event-portraits .fighter-portrait img{height:145px}.event-portraits .portrait-fallback{display:none}
.event-portraits .fighter-portrait:last-child{margin-left:-25px}
@media(max-width:760px){
.fight-row .fight-matchup{grid-template-columns:minmax(0,1fr) 28px minmax(0,1fr)}
.fight-row .fight-side,.fight-row .fight-side.right{flex-direction:column;gap:0;padding:0 8px;min-height:0;text-align:center}
.fighter-portrait{width:100%;flex:auto;align-self:center}.fighter-portrait img,.fight-row.main-event .fighter-portrait img{height:210px}
.fight-row.main-event .fight-side{min-height:0}.fighter-copy{width:100%;padding:14px 0 20px}.fight-row .fight-name{font-size:21px;min-height:47px}
.event-link.with-portraits{grid-template-columns:1fr 150px;gap:5px 8px;padding:14px 0}.event-link.with-portraits .event-date{grid-column:1}.event-link.with-portraits .event-portraits{grid-column:2;grid-row:1/3}.event-portraits .fighter-portrait img{height:130px}
}
@media(max-width:420px){.fighter-portrait img,.fight-row.main-event .fighter-portrait img{height:175px}.fight-row .fight-name{font-size:18px}.event-link.with-portraits{grid-template-columns:1fr 115px}.event-name{font-size:15px}.event-portraits .fighter-portrait img{height:115px}}
</style>
</head>
<body>
<header class="site-header"><div class="shell navbar"><a class="brand" href="/">Fight Predictor</a><nav class="nav"><a data-route="home" href="/">Home</a><a data-route="events" href="/events">Events</a><a data-route="predict" href="/predict">Predict</a><a data-route="results" href="/results">Results</a></nav></div></header>
<main class="shell" id="app"><div class="loading">Loading…</div></main>
<script>
const app=document.querySelector('#app');
const escapeHtml=value=>String(value??'').replace(/[&<>"]/g,char=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[char]));
const formatDate=value=>new Intl.DateTimeFormat('en-US',{year:'numeric',month:'long',day:'numeric',timeZone:'UTC'}).format(new Date(`${value}T00:00:00Z`));
const api=async(url,options)=>{const response=await fetch(url,options);const data=await response.json();if(!response.ok)throw new Error(data.detail||'Request failed.');return data};
function setActive(route){document.querySelectorAll('[data-route]').forEach(link=>link.classList.toggle('active',link.dataset.route===route))}
function empty(title,copy){return `<div class="empty-state"><strong>${escapeHtml(title)}</strong><p>${escapeHtml(copy)}</p></div>`}
function recordStrip(results){const accuracy=results.winner_accuracy==null?'—':`${(results.winner_accuracy*100).toFixed(1)}%`;return `<div class="record-strip"><div class="record-stat"><div class="record-label">Winner model</div><div class="record-value">${escapeHtml(results.model_version)}</div></div><div class="record-stat"><div class="record-label">Historical test accuracy</div><div class="record-value">${(results.historical_accuracy*100).toFixed(2)}%</div></div><div class="record-stat"><div class="record-label">Tracked predictions</div><div class="record-value">${results.tracked_predictions.toLocaleString()}</div></div><div class="record-stat"><div class="record-label">Public winner accuracy</div><div class="record-value">${accuracy}</div></div></div><p class="record-note">Historical test: ${results.historical_test_fights} held-out fights. Fighter data through ${escapeHtml(results.historical_data_through)}. Public accuracy appears only after tracked fights have verified results.</p>`}
function fighterPortrait(name,id){return `<figure class="fighter-portrait"><svg viewBox="0 0 180 280" aria-hidden="true"><circle cx="90" cy="57" r="35"/><path d="M47 100Q90 83 133 100L159 210H126L119 280H61L54 210H21Z"/></svg><img src="/api/fighter-portrait?name=${encodeURIComponent(name)}${id?'&espn_id='+encodeURIComponent(id):''}" alt="${escapeHtml(name)}" loading="lazy" decoding="async" onload="this.parentElement.classList.add('loaded')" onerror="this.parentElement.classList.add('no-photo')"><span class="portrait-fallback">Photo unavailable</span></figure>`}
function eventList(events){if(!events.length)return empty('No verified upcoming events','Announced cards will appear when the schedule refreshes.');return `<div class="event-list">${events.map(event=>`<a class="event-link ${event.headliners?.length?'with-portraits':''}" href="/event/${encodeURIComponent(event.event_id)}"><div class="event-date">${formatDate(event.event_date)}</div><div><div class="event-name">${escapeHtml(event.event_name)}</div><div class="event-location">${escapeHtml(event.location||'Location not listed')}</div><div class="event-count">${event.fight_count} scheduled fights</div></div>${event.headliners?.length?`<div class="event-portraits">${event.headliners.map(f=>fighterPortrait(f.name,f.espn_id)).join('')}</div>`:''}</a>`).join('')}</div>`}
async function home(){setActive('home');const [events,results]=await Promise.all([api('/api/events'),api('/api/results')]);let next=empty('No verified next event','The schedule refreshes automatically. Announced upcoming cards will appear here.');if(events.next_event){const detail=await api(`/api/events/${encodeURIComponent(events.next_event.event_id)}`);next=eventCard(detail.event,true)}app.innerHTML=`<div class="page-head"><div><h1>Fight Predictor</h1><p>UFC projections and a locked public model record.</p></div><span class="meta">Winner Model ${escapeHtml(results.model_version)}</span></div><section class="section"><div class="section-head"><h2>Next event</h2><a href="/events">All events</a></div>${next}</section><section class="section"><div class="section-head"><h2>Model record</h2></div>${recordStrip(results)}</section><section class="section"><div class="section-head"><h2>Upcoming events</h2></div>${eventList(events.events)}</section>`}
async function eventsPage(){setActive('events');const data=await api('/api/events');app.innerHTML=`<div class="page-head"><div><h1>Upcoming events</h1><p>Upcoming UFC cards refresh hourly. Open an event for pre-fight predictions.</p></div><span class="meta">${escapeHtml(data.source)}</span></div><p class="source-note">${data.schedule_warning?escapeHtml(data.schedule_warning):"Cards can change. Predictions use fighter data through June 27, 2026."}${data.schedule_fetched_at?` Last checked: ${escapeHtml(new Date(data.schedule_fetched_at).toLocaleString())}.`:""}</p><section class="section">${eventList(data.events)}</section>`}
function reasonChips(prediction){return prediction.winner_explanation.slice(0,3).map(item=>`<span><strong>${escapeHtml(item.category)}</strong> · ${escapeHtml(item.advantage)}</span>`).join('')}
function fightSide(name,id,probability,picked,right=false){return `<div class="fight-side ${right?'right':''}">${fighterPortrait(name,id)}<div class="fighter-copy">${picked?'<span class="pick-mark">Model pick</span>':''}<div class="fight-name">${escapeHtml(name)}</div>${probability==null?'':`<div class="fight-percent">${probability.toFixed(1)}%</div>`}</div></div>`}
function eventFight(fight,index){const p=fight.prediction;const matchup=`<div class="fight-matchup">${fightSide(fight.fighter_a,fight.fighter_a_espn_id,p?.fighter_a_probability,!!p&&p.predicted_winner===p.fighter_a)}<div class="fight-vs">VS</div>${fightSide(fight.fighter_b,fight.fighter_b_espn_id,p?.fighter_b_probability,!!p&&p.predicted_winner===p.fighter_b,true)}</div>`;const label=`<div class="bout-label">${escapeHtml(fight.card_section||'Fight')} ? ${escapeHtml(fight.weight_class||'Weight class not listed')} ? ${fight.number_of_rounds} rounds</div>`;if(!p)return `<article class="fight-row ${index===0?'main-event':''}">${label}${matchup}<div class="unavailable"><strong>Prediction unavailable</strong>${escapeHtml(fight.prediction_unavailable_reason)}</div></article>`;const method=p.method_probabilities[0];return `<article class="fight-row ${index===0?'main-event':''}">${label}${matchup}<div class="probability" style="--left:${p.fighter_a_probability}%"><span></span><span></span></div><div class="fight-summary"><div class="summary-cell"><div class="summary-label">Model pick</div><div class="summary-value">${escapeHtml(p.predicted_winner)}</div></div><div class="summary-cell"><div class="summary-label">Likely method</div><div class="summary-value">${escapeHtml(method.method)} ? ${method.probability.toFixed(1)}%</div></div><div class="summary-cell"><div class="summary-label">Confidence</div><div class="summary-value">${escapeHtml(p.winner_confidence)}</div></div></div><div class="reason-summary">${reasonChips(p)}</div></article>`}
function eventCard(event,compact=false){const fights=event.fights||[];return `<div class="event-header"><h1>${escapeHtml(event.event_name)}</h1><div class="event-details"><span>${formatDate(event.event_date)}</span>${event.location?`<span>${escapeHtml(event.location)}</span>`:''}<span>${event.fight_count} scheduled fight${event.fight_count===1?'':'s'}</span></div></div>${fights.length?`<div class="fight-card">${fights.map(eventFight).join('')}</div>`:empty('Card not available','This verified event does not yet have announced matchups.')}<p class="source-note">Fighter portraits: UFC / ESPN.</p>${compact?'':`<p class="source-note">Predictions are timestamped and locked before the event. Fighter data through ${escapeHtml(event.historical_data_through)}. Changed matchups receive new picks; original picks remain in history.</p>`}`}
async function eventPage(id){setActive('events');const data=await api(`/api/events/${encodeURIComponent(id)}`);app.innerHTML=eventCard(data.event)}
class Selector{constructor(side,names,onChange){this.side=side;this.names=names;this.value='';this.onChange=onChange;this.input=document.querySelector(`#fighter-${side}`);this.menu=document.querySelector(`#options-${side}`);this.label=document.querySelector(`#selected-${side}`);this.matches=[];this.active=-1;this.input.addEventListener('focus',()=>this.render());this.input.addEventListener('input',()=>{this.select('');this.render()});this.input.addEventListener('keydown',e=>this.keys(e));this.menu.addEventListener('mousedown',e=>{const target=e.target.closest('[data-name]');if(target){e.preventDefault();this.select(target.dataset.name);this.close()}})}select(name){this.value=name;if(name)this.input.value=name;this.input.setAttribute('aria-invalid','false');this.label.textContent=name||'Select fighter';this.label.classList.toggle('empty',!name);this.onChange()}render(){const query=this.input.value.trim().toLocaleLowerCase();this.matches=query?this.names.filter(name=>name.toLocaleLowerCase().includes(query)):this.names;const fragment=document.createDocumentFragment(),status=document.createElement('div');status.className='list-status';status.textContent=`${this.matches.length.toLocaleString()} fighters`;fragment.append(status);if(!this.matches.length){const empty=document.createElement('div');empty.className='no-options';empty.textContent='No matching fighters';fragment.append(empty)}else this.matches.forEach(name=>{const option=document.createElement('button');option.type='button';option.className='option';option.dataset.name=name;option.setAttribute('aria-selected',String(this.value===name));const index=name.toLocaleLowerCase().indexOf(query);if(query&&index>=0){option.append(document.createTextNode(name.slice(0,index)));const mark=document.createElement('mark');mark.textContent=name.slice(index,index+query.length);option.append(mark,document.createTextNode(name.slice(index+query.length)))}else option.textContent=name;fragment.append(option)});this.menu.replaceChildren(fragment);this.menu.classList.add('open');this.input.setAttribute('aria-expanded','true');this.active=-1}close(){this.menu.classList.remove('open');this.input.setAttribute('aria-expanded','false');this.active=-1}keys(e){if(e.key==='Escape'){this.close();return}if(e.key==='Enter'&&this.active>=0){e.preventDefault();this.select(this.matches[this.active]);this.close();return}if(!['ArrowDown','ArrowUp'].includes(e.key))return;e.preventDefault();if(!this.menu.classList.contains('open'))this.render();this.active=e.key==='ArrowDown'?Math.min(this.active+1,this.matches.length-1):Math.max(this.active-1,0);const options=this.menu.querySelectorAll('.option');options.forEach(item=>item.classList.remove('active'));if(options[this.active]){options[this.active].classList.add('active');options[this.active].scrollIntoView({block:'nearest'})}}}
function reasonList(items,counter=false){return `<ul class="reason-list ${counter?'counter':''}">${items.map(item=>`<li><div class="reason-category">${escapeHtml(item.category)} <span class="reason-level">${escapeHtml(item.advantage)} ${counter?'factor':'advantage'}</span></div><div class="reason-copy">${escapeHtml(item.explanation)}</div></li>`).join('')}</ul>`}
function manualResult(p){
 const aWon=p.predicted_winner===p.fighter_a,counters=aWon?p.factors_for_fighter_b:p.factors_for_fighter_a;
 const outcomes=p.outcome_probabilities.map(item=>`<div class="method-row"><span>${escapeHtml(item.fighter)} · ${escapeHtml(item.method)}</span><div class="method-track"><div class="method-fill" style="width:${item.probability}%"></div></div><span class="method-value">${item.probability.toFixed(1)}%</span></div>`).join('');
 const warning=p.matchup_warning?`<p class="matchup-warning">${escapeHtml(p.matchup_warning)}</p>`:'';
 const lowWarning=p.low_data_warning?`<p class="matchup-warning">${escapeHtml(p.low_data_warning)} The probability is unchanged; uncertainty is higher.</p>`:'';
 return `<div class="result-head"><strong>Prediction</strong><span class="meta">Data through ${escapeHtml(p.historical_data_through)}</span></div>${lowWarning}<div class="manual-fight"><div class="fight-matchup"><div class="fight-side">${aWon?'<span class="pick-mark">Model pick</span>':''}<div class="fight-name">${escapeHtml(p.fighter_a)}</div><div class="fight-percent">${p.fighter_a_probability.toFixed(1)}%</div><div class="meta">${escapeHtml(p.fighter_a_prediction_mode)}</div></div><div class="fight-vs">vs</div><div class="fight-side right">${aWon?'':'<span class="pick-mark">Model pick</span>'}<div class="fight-name">${escapeHtml(p.fighter_b)}</div><div class="fight-percent">${p.fighter_b_probability.toFixed(1)}%</div><div class="meta">${escapeHtml(p.fighter_b_prediction_mode)}</div></div></div><div class="probability" style="--left:${p.fighter_a_probability}%"><span></span><span></span></div></div><div class="details-grid"><div class="detail-stats"><div class="detail"><div class="detail-label">Model pick</div><div class="detail-value">${escapeHtml(p.predicted_winner)}</div></div><div class="detail"><div class="detail-label">Prediction mode</div><div class="detail-value">${escapeHtml(p.prediction_mode)}</div></div><div class="detail"><div class="detail-label">Weight-class difference</div><div class="detail-value">${escapeHtml(p.mismatch_category)}</div></div><div class="detail"><div class="detail-label">Matchup reliability</div><div class="detail-value">${escapeHtml(p.matchup_confidence)}</div></div></div><div class="method-panel"><h3>Method conditional on ${escapeHtml(p.predicted_winner)} winning</h3><div class="method-list">${p.method_probabilities.map(item=>`<div class="method-row"><span>${escapeHtml(item.method)}</span><div class="method-track"><div class="method-fill" style="width:${item.probability}%"></div></div><span class="method-value">${item.probability.toFixed(1)}%</span></div>`).join('')}</div><p class="method-note">Method confidence: ${escapeHtml(p.method_confidence)}.</p>${warning}<h3 class="outcome-title">Overall outcomes</h3><div class="method-list">${outcomes}</div></div></div><div class="reasons"><div class="reason-panel"><h3>Why the model favors ${escapeHtml(p.predicted_winner)}</h3>${reasonList(p.winner_explanation)}</div><div class="reason-panel"><h3>Factors favoring ${escapeHtml(aWon?p.fighter_b:p.fighter_a)}</h3>${reasonList(counters.slice(0,3),true)}</div></div>`
}
async function predictPage(){setActive('predict');const data=await api('/api/fighters');app.innerHTML=`<div class="page-head"><div><h1>Manual predictor</h1><p>Compare two fighters using their latest available historical snapshots.</p></div><span class="meta">${data.count.toLocaleString()} fighters</span></div><section class="section"><form id="form"><div class="predict-grid"><div class="fighter-box"><div class="fighter-label">Fighter A</div><div class="selected-name empty" id="selected-a">Select fighter</div><div class="fighter-search"><input class="search-input" id="fighter-a" autocomplete="off" placeholder="Search fighters" role="combobox" aria-expanded="false"><div class="options" id="options-a"></div></div></div><div class="versus">vs</div><div class="fighter-box right"><div class="fighter-label">Fighter B</div><div class="selected-name empty" id="selected-b">Select fighter</div><div class="fighter-search"><input class="search-input" id="fighter-b" autocomplete="off" placeholder="Search fighters" role="combobox" aria-expanded="false"><div class="options" id="options-b"></div></div></div></div><div class="form-actions"><p class="error" id="form-error"></p><button class="button" id="submit" disabled>Select two fighters</button></div></form><div class="prediction-result" id="prediction-result"></div></section>`;const submit=document.querySelector('#submit'),error=document.querySelector('#form-error');let loading=false;const update=()=>{const ready=a.value&&b.value,same=ready&&a.value.toLocaleLowerCase()===b.value.toLocaleLowerCase();submit.disabled=loading||!ready||same;submit.textContent=loading?'Calculating…':ready?(same?'Choose different fighters':'Predict fight'):'Select two fighters'};const a=new Selector('a',data.fighters,update),b=new Selector('b',data.fighters,update);document.addEventListener('mousedown',event=>{if(!event.target.closest('.fighter-search')){a.close();b.close()}},{once:false});document.querySelector('#form').addEventListener('submit',async event=>{event.preventDefault();error.textContent='';if(!a.value||!b.value)return;if(a.value===b.value){error.textContent='Choose two different fighters.';return}loading=true;update();try{const p=await api('/api/predict',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({fighter_a:a.value,fighter_b:b.value})});const target=document.querySelector('#prediction-result');target.innerHTML=manualResult(p);target.classList.add('visible');target.scrollIntoView({behavior:'smooth',block:'start'})}catch(requestError){error.textContent=requestError.message}finally{loading=false;update()}})}
async function resultsPage(){setActive('results');const data=await api('/api/results');const rows=data.predictions.map(item=>`<tr><td>${formatDate(item.event_date)}</td><td>${escapeHtml(item.event_name)}</td><td>${escapeHtml(item.fighter_a)} vs ${escapeHtml(item.fighter_b)}</td><td>${escapeHtml(item.predicted_winner)}</td><td>${escapeHtml(item.predicted_method||'—')}</td><td>${item.actual_winner?escapeHtml(item.actual_winner):'Pending'}</td></tr>`).join('');app.innerHTML=`<div class="page-head"><div><h1>Prediction record</h1><p>Predictions saved before event results are known.</p></div><span class="meta">No result is fabricated</span></div><section class="section">${recordStrip(data)}</section><section class="section"><div class="section-head"><h2>Tracked predictions</h2></div>${rows?`<div class="history-wrap"><table class="history-table"><thead><tr><th>Date</th><th>Event</th><th>Fight</th><th>Winner pick</th><th>Method pick</th><th>Result</th></tr></thead><tbody>${rows}</tbody></table></div>`:empty('No public predictions yet','Predictions will appear here after a verified upcoming event card is loaded and published.')}</section>`}
async function route(){try{const path=location.pathname;if(path==='/predict')return await predictPage();if(path==='/events')return await eventsPage();if(path==='/results')return await resultsPage();if(path.startsWith('/event/'))return await eventPage(decodeURIComponent(path.slice(7)));return await home()}catch(error){app.innerHTML=empty('Page unavailable',error.message)}}
route();
</script>
